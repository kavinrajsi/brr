# ─── Supabase ─────────────────────────────────────────────────────────────────
# Required for all server-side data access
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Required for chat, evaluate, fix, and MCP routes. The app degrades gracefully
# if missing — most AI features will return 503.
ANTHROPIC_API_KEY=sk-ant-...

# ─── Stripe (optional — billing degrades gracefully if unset) ────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ─── Platform admin allowlist ────────────────────────────────────────────────
# Comma-separated Supabase user UUIDs that may access /api/admin/*. Without
# this, all admin endpoints will 403 (the safe default).
ADMIN_USER_IDS=

# Client-visible mirror of ADMIN_USER_IDS — used only to hide the "Admin" nav
# link for non-admins. UUIDs are not secrets; this is a UX nicety, not a
# security control. The real gate is the server-side ADMIN_USER_IDS above.
NEXT_PUBLIC_ADMIN_USER_IDS=
